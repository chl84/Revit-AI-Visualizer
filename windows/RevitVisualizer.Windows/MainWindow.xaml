<Window x:Class="RevitVisualizer.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RevitVisualizer.Windows"
        Title="Revit AI Visualizer" Width="1180" Height="800" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Revit AI Visualizer" FontSize="26" FontWeight="SemiBold" />
        <TextBlock x:Name="StageLabel" Text="1 / 3 · Capture" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
      </StackPanel>
      <Button x:Name="ClearKeyButton" Grid.Column="1" Content="Clear key" Click="ClearKey_Click" Visibility="Collapsed" VerticalAlignment="Center" />
    </Grid>
    <Grid x:Name="Workspace" Grid.Row="1">
      <Grid x:Name="CapturePanel">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="#171D20" BorderBrush="#34443D" BorderThickness="1" CornerRadius="8">
          <Grid Margin="24">
            <StackPanel x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
              <TextBlock Text="Start with your Revit viewport" FontSize="25" FontWeight="SemiBold" TextAlignment="Center" />
              <TextBlock Text="Open a saved image, paste an image from the clipboard, or capture a region directly from your screen."
                         TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,16,0,0" />
            </StackPanel>
            <Image x:Name="SourcePreview" Stretch="Uniform" Visibility="Collapsed" />
          </Grid>
        </Border>
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
          <TextBlock x:Name="SourceInfo" Text="Your original image is preserved." Foreground="{StaticResource Muted}" Margin="0,0,0,12" />
          <WrapPanel>
            <Button Content="Open image" Click="OpenImage_Click" />
            <Button Content="Capture screen area" Click="CaptureScreen_Click" />
            <Button Content="Paste image" Click="PasteImage_Click" />
            <Button x:Name="PrepareButton" Content="Prepare image" Style="{StaticResource Primary}" IsEnabled="False" Click="Prepare_Click" />
          </WrapPanel>
        </StackPanel>
      </Grid>
      <Grid x:Name="PreparePanel" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
        <local:CropEditor x:Name="Editor" Margin="0,0,20,0" AutomationProperties.Name="Crop selection. Drag the four corner handles." />
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="Frame the Revit viewport" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="Drag the four corner handles to remove the surrounding interface." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,20" />
            <CheckBox x:Name="PerspectiveToggle" Content="Correct perspective" Checked="Perspective_Changed" Unchecked="Perspective_Changed" Margin="0,0,0,16" />
            <StackPanel x:Name="AspectPanel" Visibility="Collapsed">
              <TextBlock Text="Viewport aspect ratio" Margin="0,0,0,6" />
              <TextBox x:Name="AspectEntry" AutomationProperties.Name="Viewport aspect ratio, for example 16:9" />
              <TextBlock Text="For example 16:9. Use the viewport's true ratio to preserve proportions. Blank estimates it from the selected edges."
                         TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,16" />
            </StackPanel>
            <Button Content="Reset selection" Click="ResetSelection_Click" Margin="0,0,0,16" />
            <TextBlock Text="Sends this prepared image to OpenAI using your paid API account. Generation can take several minutes."
                       TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,12" />
            <Button Content="Visualize" Style="{StaticResource Primary}" Click="Visualize_Click" Margin="0,0,0,12" />
            <Button Content="Back" Click="BackToCapture_Click" Margin="0" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid x:Name="ResultPanel" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
          <TextBlock Text="Review the architecture" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="AI can change geometry. Check windows, rooflines and proportions against the original." Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <local:ComparisonViewer x:Name="Comparison" Grid.Row="1" AutomationProperties.Name="Original and result comparison. Scroll to zoom; drag to pan." />
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
          <WrapPanel Margin="0,0,0,8">
            <RadioButton x:Name="OriginalMode" Content="Original" GroupName="CompareMode" Checked="CompareMode_Changed" />
            <RadioButton x:Name="ResultMode" Content="Result" GroupName="CompareMode" Checked="CompareMode_Changed" IsChecked="True" />
            <RadioButton x:Name="OverlayMode" Content="Overlay" GroupName="CompareMode" Checked="CompareMode_Changed" />
            <TextBlock x:Name="ZoomLabel" Text="Zoom 100% · Scroll to zoom, drag to pan" Foreground="{StaticResource Muted}" />
          </WrapPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Original opacity" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0" Maximum="100" Value="50" IsEnabled="False" ValueChanged="Opacity_Changed" AutomationProperties.Name="Original opacity" />
            <Button Grid.Column="2" Content="Reset view" Click="ResetView_Click" Margin="16,0,0,0" />
          </Grid>
          <TextBlock x:Name="ResultInfo" Foreground="{StaticResource Muted}" Margin="0,8,0,12" TextWrapping="Wrap" />
          <WrapPanel>
            <Button Content="Save PNG" Style="{StaticResource Primary}" Click="Save_Click" />
            <Button Content="Back to prepare" Click="BackToPrepare_Click" />
            <Button Content="New image" Click="NewImage_Click" />
          </WrapPanel>
        </StackPanel>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="#171D20" Padding="12" Margin="0,16,0,0" CornerRadius="5">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="StatusLabel" Text="Ready" TextWrapping="Wrap" />
          <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="Collapsed" />
        </StackPanel>
        <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel generation" Click="Cancel_Click" Visibility="Collapsed" Margin="12,0,0,0" />
      </Grid>
    </Border>
  </Grid>
</Window>
