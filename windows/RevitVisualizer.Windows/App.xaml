<Application x:Class="RevitVisualizer.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#C2DDCB" />
    <SolidColorBrush x:Key="Muted" Color="#AFBAB4" />
    <Style TargetType="Window">
      <Setter Property="Background" Value="#101416" /><Setter Property="Foreground" Value="#E5EBE7" />
      <Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="14" />
    </Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E5EBE7" /></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,10" /><Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Background" Value="#26302F" /><Setter Property="Foreground" Value="#E5EBE7" />
      <Setter Property="BorderBrush" Value="#52645C" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Panel" CornerRadius="5" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Panel" Property="Opacity" Value="0.8" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Panel" Property="Opacity" Value="0.4" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}" /><Setter Property="Foreground" Value="#183226" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#26302F" /><Setter Property="Foreground" Value="#E5EBE7" />
      <Setter Property="BorderBrush" Value="#52645C" /><Setter Property="Padding" Value="10,8" />
      <Setter Property="CaretBrush" Value="White" />
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#26302F" /><Setter Property="Foreground" Value="#E5EBE7" />
      <Setter Property="BorderBrush" Value="#52645C" /><Setter Property="Padding" Value="10,8" />
      <Setter Property="CaretBrush" Value="White" />
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E5EBE7" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#E5EBE7" /><Setter Property="Margin" Value="0,0,20,0" /></Style>
    <Style TargetType="Slider"><Setter Property="Margin" Value="0,8,0,8" /></Style>
  </Application.Resources>
</Application>
